  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/earnify-admin/Dashboard/?$",
      "dest": "/earnify-admin/Dashboard/index.html"
    },
    {
      "src": "/earnify-admin/Dashboard/(.*)",
      "dest": "/earnify-admin/Dashboard/$1"
    },
    {
      "src": "/earnify-admin/statistic/?$",
      "dest": "/earnify-admin/statistic/index.html"
    },
    {
      "src": "/earnify-admin/statistic/(.*)",
      "dest": "/earnify-admin/statistic/$1"
    },
    {
      "src": "/earnify-admin/payments/?$",
      "dest": "/earnify-admin/payments/index.html"
    },
    {
      "src": "/earnify-admin/payments/(.*)",
      "dest": "/earnify-admin/payments/$1"
    },
    {
      "src": "/earnify-admin/Blog/?$",
      "dest": "/earnify-admin/Blog/index.html"
    },
    {
      "src": "/earnify-admin/Blog/(.*)",
      "dest": "/earnify-admin/Blog/$1"
    },
    {
      "src": "/earnify-admin/(.*)",
      "dest": "/earnify-admin/$1"
    },
    {
      "src": "/file/(.*)",
      "dest": "/public/file/$1"
    },
    {
      "src": "/(.*\\.js)$",
      "dest": "/public/$1",
      "headers": {
        "Content-Type": "application/javascript"
      }
    },
    {
      "src": "/admin/Resources/?$",
      "dest": "/public/admin/Resources/index.html"
    },
    {
      "src": "/admin/Resources/(.*)",
      "dest": "/public/admin/Resources/$1"
    },
    {
      "src": "/admin/Statistics/?$",
      "dest": "/public/admin/Statistics/index.html"
    },
    {
      "src": "/admin/Statistics/(.*)",
      "dest": "/public/admin/Statistics/$1"
    },
    {
      "src": "/admin/Profile/?$",
      "dest": "/public/admin/Profile/index.html"
    },
    {
      "src": "/admin/Profile/(.*)",
      "dest": "/public/admin/Profile/$1"
    },
    {
      "src": "/admin/Withdrawal/?$",
      "dest": "/public/admin/Withdrawal/index.html"
    },
    {
      "src": "/admin/Withdrawal/(.*)",
      "dest": "/public/admin/Withdrawal/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/public/admin/$1"
    },
    {
      "src": "/About/?$",
      "dest": "/public/About/index.html"
    },
    {
      "src": "/Contact/?$",
      "dest": "/public/Contact/index.html"
    },
    {
      "src": "/Privacy/?$",
      "dest": "/public/Privacy/index.html"
    },
    {
      "src": "/Terms/?$",
      "dest": "/public/Terms/index.html"
    },
    {
      "src": "/Dashboard/?$",
      "dest": "/public/Dashboard/index.html"
    },
    {
      "src": "/Detail/?$",
      "dest": "/public/Detail/index.html"
    },
    {
      "src": "/Detail/.*",
      "dest": "/public/Detail/index.html"
    },
    {
      "src": "/Payment/?$",
      "dest": "/public/Payment/index.html"
    },
    {
      "src": "/(.*\\.(html|png|jpg|jpeg|gif|svg|ico|pdf|xls|xlsx))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
