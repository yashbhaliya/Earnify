{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/file/(.*)",
      "dest": "/public/file/$1"
    },
    {
      "src": "/(.*\\.js)$",
      "dest": "/public/$1",
      "headers": {
        "Content-Type": "application/javascript"
      }
    },
    {
      "src": "/(.*\\.css)$",
      "dest": "/public/$1",
      "headers": {
        "Content-Type": "text/css"
      }
    },
    {
      "src": "/admin/Resources/?$",
      "dest": "/public/admin/Resources/index.html"
    },
    {
      "src": "/admin/Statistics/?$",
      "dest": "/public/admin/Statistics/index.html"
    },
    {
      "src": "/admin/Profile/?$",
      "dest": "/public/admin/Profile/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/public/admin/$1"
    },
    {
      "src": "/About/?$",
      "dest": "/public/About/index.html"
    },
    {
      "src": "/Contact/?$",
      "dest": "/public/Contact/index.html"
    },
    {
      "src": "/Privacy/?$",
      "dest": "/public/Privacy/index.html"
    },
    {
      "src": "/Terms/?$",
      "dest": "/public/Terms/index.html"
    },
    {
      "src": "/Dashboard/?$",
      "dest": "/public/Dashboard/index.html"
    },
    {
      "src": "/Detail/?$",
      "dest": "/public/Detail/index.html"
    },
    {
      "src": "/Detail/.*",
      "dest": "/public/Detail/index.html"
    },
    {
      "src": "/Payment/?$",
      "dest": "/public/Payment/index.html"
    },
    {
      "src": "/(.*\\.(html|png|jpg|jpeg|gif|svg|ico|pdf|xls|xlsx))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}